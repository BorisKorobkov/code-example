{
  "name": "boriskorobkov/code-example",
  "description": "Code example",
  "version": "0.2.1",
  "authors": [
    {
      "name": "Boris Korobkov",
      "email": "boris@korobkov.su",
      "role": "Developer"
    }
  ],
  "scripts": {
    "docker:build": "docker build --tag boriskorobkov/code-example -f docker/Dockerfile --target code-example .",
    "docker:up": "docker-compose --env-file docker/docker-compose.env -f docker/docker-compose.yml up",
    "docker:xdebug-up": "docker-compose --env-file docker/docker-compose.env -f docker/docker-compose.yml -f docker/docker-compose.xdebug.yml up",
    "docker:rm": "docker rm adminer nginx php db && docker volume rm docker_mysql"
  }
}
